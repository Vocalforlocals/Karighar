# ==============================================================================
# ShilpSetu (विश्वकला) — Production Environment Configuration (.env.example)
# Ministry of Social Justice & Empowerment (MoSJE) | SIH 2026 Problem Statement #26090
# Copy to .env and configure for production cloud deployment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & TLS NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=production
HTTPS_PORT=8443
HTTP_PORT=8080
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. STORAGE ENGINE (json = Embedded Atomic Local | postgres = Enterprise Relational)
# ------------------------------------------------------------------------------
DB_ENGINE=json
DATABASE_URL=postgresql://shilpsetudo_admin:ShilpSetuGov2026@localhost:5432/shilpsetudo_db
DB_SSL=false
DB_POOL_MAX=20

# ------------------------------------------------------------------------------
# 3. CACHE & SSE BUS (memory = Embedded Standalone | redis = Distributed Cluster)
# ------------------------------------------------------------------------------
CACHE_ENGINE=memory
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 4. CRYPTOGRAPHIC SECRETS & AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_SECRET=shilpsetudo_jwt_secure_key_2026_super_secret
JWT_EXPIRY=24h

# ------------------------------------------------------------------------------
# 5. GOVERNMENT CONSORTIUM WEBHOOK PRE-SHARED KEYS
# ------------------------------------------------------------------------------
GEM_WEBHOOK_SECRET=shilpsetudo_gem_secret_2026
PFMS_WEBHOOK_SECRET=shilpsetudo_pfms_secret_2026
ICEGATE_WEBHOOK_SECRET=shilpsetudo_icegate_secret_2026

# ------------------------------------------------------------------------------
# 6. CERT-IN CYBERSECURITY & AUDIT COMPLIANCE
# ------------------------------------------------------------------------------
AUDIT_RETENTION_DAYS=180
RATE_LIMIT_PROFILE=STANDARD
