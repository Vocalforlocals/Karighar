{
  "info": {
    "_postman_id": "karighar-unified-api-collection-2026",
    "name": "Karighar (कारीघर) Unified API Collection",
    "description": "Comprehensive Postman collection for Karighar REST APIs under MoSJE Problem Statement #26090. Includes Buyer Journey, Artisan Studio, AI Computer Vision, Varta-AI Negotiation, Escrow/PFMS, and Blockchain Provenance.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://karighar.vercel.app",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "sampleProductId",
      "value": "prod_01",
      "type": "string"
    },
    {
      "key": "sampleOrderId",
      "value": "ORD-2026-9041",
      "type": "string"
    },
    {
      "key": "geminiApiKey",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication & Profile",
      "item": [
        {
          "name": "Login (Buyer Persona)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"BUYER\",\n  \"email\": \"procurement@fabindia.com\",\n  \"password\": \"buyer2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Ananya Sharma\",\n  \"phone\": \"+91 98765 12345\",\n  \"email\": \"ananya@craftbuyer.org\",\n  \"password\": \"securePass2026\",\n  \"role\": \"BUYER\",\n  \"organization\": \"Heritage Crafts Export\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Send Mobile OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+91 98765 43210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "send-otp"]
            }
          }
        },
        {
          "name": "Verify Mobile OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+91 98765 43210\",\n  \"otp\": \"7829\"\n}"
