              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "verify-otp"]
            }
          }
        },
        {
          "name": "Get Current User Profile (/me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Buyer Journey - Catalog & Marketplace",
      "item": [
        {
          "name": "List GI Products (Catalog)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products?category=Textiles%20%26%20Weaves&q=Silk",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"],
              "query": [
                { "key": "category", "value": "Textiles%20%26%20Weaves" },
                { "key": "q", "value": "Silk" }
              ]
            }
          }
        },
        {
          "name": "Get Craft Details & Provenance Hash",
          "request": {
            "method": "GET",
            "header": [],
